METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=replace-me
NVIDIA_API_KEY=replace-me
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=replace-me
ZETARIS_API_KEY=replace-me
SAMPLE_MODE=true
# Optional: pin the Nightshift receipt-signing public key (base64). When set, a receipt
# signed by any other key is refused. Not a secret; printed in every receipt envelope.
NS_RECEIPT_PUBKEY=
# Nightshift 1.2.3 gates Super VL off by default. Every read here pins Super VL, so opt in
# once: add "NVIDIA_SUPER_VL": "true" to %LOCALAPPDATA%\ai.meterless.runtime\state\engine-kv.json
# with Nightshift closed (back the file up first). Without it, doctor's signed Super VL call
# is refused with Nightshift's own message naming the flag.
